{
    "name": "investmatch/nepal",
    "description": "InvestMatch Nepal - Investment Pitch Platform",
    "type": "project",
    "require": {
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
